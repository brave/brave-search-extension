{
  "manifest_version": 3,
  "author": "Brave Software",
  /**
   * AMO caps names at 45 characters (and lets us edit the listing name after
   * upload); the Chrome Web Store reads the name straight from the manifest
   * and caps it at 75. Hence two names.
   */
  "firefox:name": "Brave Search",
  "chromium:name": "Brave Search (official) - Private Search Engine",
  "description": "Configures Brave Search as the default search engine.",
  "default_locale": "en_US",
  /**
   * Version is automatically injected from package.json during the build process.
   * Do not manually set the version here - update package.json instead.
   */
  /**
   * Icons have been—and may continue to be—retrieved from
   * https://github.com/alrra/browser-logos/tree/main/src/brave
   */
  "icons": {
    "16": "icons/brave_16x16.png",
    "32": "icons/brave_32x32.png",
    "48": "icons/brave_48x48.png",
    "64": "icons/brave_64x64.png",
    "128": "icons/brave_128x128.png"
  },
  "firefox:browser_specific_settings": {
    "gecko": {
      /**
       * Must be a GUID or an email-like string - use a fake address here,
       * since a real one may attract spam.
       */
      "id": "brave-search-extension@brave.com",
      /**
       * Track the current Firefox ESR as our floor; revisit at each yearly
       * ESR transition rather than bumping ad hoc for individual features.
       * Current ESR: https://whattrainisitnow.com/release/?version=esr
       * (Mozilla's own release wiki redirects here.) Valid Gecko versions:
       * https://addons.mozilla.org/api/v5/applications/firefox/
       */
      "strict_min_version": "140.0"
    },
    /**
     * Must be an empty object to support Firefox for Android without pinning
     * a version range - otherwise the extension is desktop-only.
     */
    "gecko_android": {}
  },
  "chrome_url_overrides": {
    "newtab": "newtab/index.html"
  },
  "chrome_settings_overrides": {
    "search_provider": {
      /**
       * The Chrome Web Store requires a full URL; Firefox's MV3 docs call
       * for a relative path. We provide both accordingly.
       */
      "chromium:favicon_url": "https://cdn.search.brave.com/serp/v1/static/brand/eebf5f2ce06b0b0ee6bbd72d7e18621d4618b9663471d42463c692d019068072-brave-lion-favicon.png",
      "firefox:favicon_url": "icons/brave_64x64.png",
      /**
       * "Brave", not "Brave Search" - both browsers already add "Search"
       * nearby (Chrome: "<name> Search", Firefox: "Search with <name>"),
       * so the fuller name would double up.
       */
      "name": "Brave",
      "keyword": "@brave",
      "encoding": "UTF-8",
      /**
       * Chromium maps id 109 to Brave in its own prepopulated engine list:
       * https://chromium.googlesource.com/external/search_engines_data/+/refs/heads/main/definitions/prepopulated_engines.json
       * We still tag search_url/suggest_url ourselves below, and put our
       * tag first so it wins if Chromium appends its own.
       */
      "chromium:prepopulated_id": 109,
      "search_url": "https://search.brave.com/search?q={searchTerms}&source=extension-omni",
      "suggest_url": "https://search.brave.com/api/suggest?q={searchTerms}&source=extension-omni",
      "is_default": true
    }
  }
}
